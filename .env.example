# ==============================================================================
# TgTracker - Environment Configuration Template (.env.example)
# Copy this file to .env and populate with your production credentials.
#
# SECURITY DIRECTIVE:
# Never commit your populated .env file or your encrypted session keys to Git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Telegram API Credentials
# Obtain these from: https://my.telegram.org (under 'API development tools')
# ------------------------------------------------------------------------------
# Integer Application ID 
TELEGRAM_API_ID=12345678

# 32-character hexadecimal Application Hash
TELEGRAM_API_HASH=0123456789abcdef0123456789abcdef


# ------------------------------------------------------------------------------
# 2. Telegram Bot Credentials
# Create a bot via @BotFather on Telegram (https://t.me/BotFather)
# The bot must be added as an Administrator to the receiving group with "Post Messages" permission.
# ------------------------------------------------------------------------------
# Format: <bot_id>:<token>
TELEGRAM_BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz123456


# ------------------------------------------------------------------------------
# 3. Chat Isolation Whitelist (Strict Policy Enforcement)
# 
# SOURCE_TRACK_CHAT_ID:
# The ONLY group or channel the user account will monitor.
# The security sandbox will drop all events and prohibit reading any other chat.
# Usually has the prefix -100 for supergroups and channels (e.g. -1001928374650).
#
# DESTINATION_RECEIVE_CHAT_ID:
# The receiving group where the bot will replicate messages.
# The bot is strictly restricted to sending messages to this chat only.
#
# Note: SOURCE and DESTINATION IDs must be different to prevent message loops.
# ------------------------------------------------------------------------------
SOURCE_TRACK_CHAT_ID=-1001234567890
DESTINATION_RECEIVE_CHAT_ID=-1009876543210


# ------------------------------------------------------------------------------
# 4. Session Encryption & Storage
#
# SESSION_STORAGE_MODE:
# - 'file': Stores the AES-256-GCM encrypted envelope in a local file with 0600 permissions.
# - 'env_string': Stores the Base64 encrypted envelope directly in ENCRYPTED_SESSION_STRING (100% diskless).
#
# SESSION_ENCRYPTION_KEY:
# A 256-bit URL-safe Base64 key (generated by login.py or python -c "from src.crypto import generate_encryption_key; print(generate_encryption_key())")
# OR a high-entropy master passphrase (derived via PBKDF2-HMAC-SHA256 with 600,000 rounds).
# ------------------------------------------------------------------------------
SESSION_STORAGE_MODE=file
SESSION_ENCRYPTION_KEY=YourSuperSecureAES256GCMKeyOrMasterPassphraseHere!

# Used when SESSION_STORAGE_MODE=file (default: session.enc)
ENCRYPTED_SESSION_FILE=session.enc

# Used when SESSION_STORAGE_MODE=env_string (optional, for 100% diskless serverless deployment)
# ENCRYPTED_SESSION_STRING=


# ------------------------------------------------------------------------------
# 5. Media & Replication Engine Controls
# ------------------------------------------------------------------------------
# Replicate media attachments (photos, videos, audio, voice notes, stickers, docs)
REPLICATE_MEDIA=true

# Safety limit in megabytes for streaming media in RAM.
# Media exceeding this threshold triggers a placeholder notification instead of
# risking an Out-Of-Memory condition on the server.
MAX_MEDIA_SIZE_MB=50

# Maintain reply hierarchy in the destination group using in-memory ID correlation
PRESERVE_REPLIES=true

# Replicate service notifications (pinned messages, member changes)
REPLICATE_SERVICE_MESSAGES=false


# ------------------------------------------------------------------------------
# 6. Logging & Operational Observability
# Message texts and sensitive credentials are NEVER logged regardless of log level.
# Options: DEBUG, INFO, WARNING, ERROR
# ------------------------------------------------------------------------------
LOG_LEVEL=INFO


# ------------------------------------------------------------------------------
# 7. Device Identity & Anti-Flood Protection (Optional)
# Clean metadata displayed in Telegram Settings -> Devices.
# ------------------------------------------------------------------------------
DEVICE_MODEL=TgTracker-Secure
SYSTEM_VERSION=Linux
APP_VERSION=1.0.0
FLOOD_SLEEP_THRESHOLD=120
